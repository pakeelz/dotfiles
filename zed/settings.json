// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_buffer_font_family": "Hurmit Nerd Font",
  "inlay_hints": {
    "show_background": true,
    "enabled": true
  },
  "title_bar": {
    "show_branch_status_icon": true
  },
  "tabs": {
    "file_icons": true
  },
  "file_finder": {
    "file_icons": true
  },
  "icon_theme": "Soft Charmed Icons",
  "buffer_font_weight": 900.0,
  "buffer_font_family": "DepartureMono Nerd Font",
  "soft_wrap": "editor_width",
  "relative_line_numbers": "enabled",
  "ui_font_weight": 900.0,
  "ui_font_family": "DepartureMono Nerd Font",
  "terminal": {
    "font_weight": 900.0,
    "font_family": "DepartureMono Nerd Font"
  },
  "session": {
    "trust_all_worktrees": false
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "GitHub Light Monochrome",
    "dark": "Everforest Dark Hard (regular)",
  },
}
